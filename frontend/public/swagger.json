{
  "openapi": "3.0.0",
  "info": {
    "title": "Book Management System (BMS) & E-Commerce Integration API",
    "version": "1.0.0",
    "description": "API Documentation for Kairali BMS backend services and External E-Commerce Website Integration."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "E-Commerce Shared Secret Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CatalogItem": {
        "type": "object",
        "properties": {
          "bms_id": { "type": "string", "format": "uuid" },
          "isbn13": { "type": "string", "example": "9788126412345" },
          "title": { "type": "string", "example": "ആടുജീവിതം (Aadujeevitham)" },
          "author_name": { "type": "string", "example": "Benyamin" },
          "author_id": { "type": "string" },
          "category": { "type": "string", "example": "Fiction / Novel" },
          "language": { "type": "string", "example": "Malayalam" },
          "mrp": { "type": "number", "example": 350.0 },
          "sale_price": { "type": "number", "example": 315.0 },
          "stock_quantity": { "type": "integer", "example": 45 },
          "is_active": { "type": "boolean", "example": true },
          "description": { "type": "string" },
          "cover_image_url": { "type": "string", "example": "https://cdn.kairali.in/covers/9788126412345.jpg" },
          "publisher_name": { "type": "string", "example": "Kairali Books" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "InventoryCheckRequest": {
        "type": "object",
        "required": ["isbns"],
        "properties": {
          "isbns": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["9788126412345", "9788126498765"]
          }
        }
      },
      "EcomOrderPayload": {
        "type": "object",
        "required": ["web_order_id", "payment", "customer", "items"],
        "properties": {
          "web_order_id": { "type": "string", "example": "KB-ONLINE-88492" },
          "order_timestamp": { "type": "string", "format": "date-time" },
          "payment": {
            "type": "object",
            "properties": {
              "gateway": { "type": "string", "example": "PayU" },
              "gateway_transaction_id": { "type": "string", "example": "payu_tx_9981247" },
              "status": { "type": "string", "example": "PAID" },
              "amount_paid": { "type": "number", "example": 680.0 }
            }
          },
          "customer": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "example": "Anand Kumar" },
              "email": { "type": "string", "example": "anand@example.com" },
              "phone": { "type": "string", "example": "+919876543210" }
            }
          },
          "shipping_address": {
            "type": "object",
            "properties": {
              "recipient_name": { "type": "string" },
              "phone": { "type": "string" },
              "address_line1": { "type": "string" },
              "address_line2": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "pincode": { "type": "string" },
              "country": { "type": "string" }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "isbn13": { "type": "string", "example": "9788126412345" },
                "quantity": { "type": "integer", "example": 2 },
                "unit_price": { "type": "number", "example": 315.0 }
              }
            }
          },
          "financials": {
            "type": "object",
            "properties": {
              "items_subtotal": { "type": "number" },
              "shipping_charge": { "type": "number" },
              "discount_applied": { "type": "number" },
              "grand_total": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login to BMS",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful login returning JWT access token" }
        }
      }
    },
    "/api/v1/ecommerce/catalog": {
      "get": {
        "summary": "Fetch Book Catalog & Stock Levels (E-Commerce Sync)",
        "tags": ["E-Commerce Integration"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100 } },
          { "name": "updated_since", "in": "query", "schema": { "type": "string" }, "description": "ISO timestamp for incremental sync" }
        ],
        "responses": {
          "200": {
            "description": "Paginated array of catalog books with current central stock",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "page": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "books": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/CatalogItem" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ecommerce/inventory/check": {
      "post": {
        "summary": "Live Stock & Price Check (Pre-Checkout)",
        "tags": ["E-Commerce Integration"],
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InventoryCheckRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Returns live central stock availability and prices for requested ISBNs" }
        }
      }
    },
    "/api/v1/ecommerce/orders": {
      "post": {
        "summary": "Submit Paid Online Order",
        "tags": ["E-Commerce Integration"],
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EcomOrderPayload" }
            }
          }
        },
        "responses": {
          "201": { "description": "Order accepted, stock deducted, invoice generated" }
        }
      },
      "get": {
        "summary": "Get Online Order Dispatch Queue",
        "tags": ["E-Commerce Integration"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "dispatched", "all"] } }
        ],
        "responses": {
          "200": { "description": "List of online orders queued for fulfillment" }
        }
      }
    },
    "/api/v1/ecommerce/orders/{id}/dispatch": {
      "post": {
        "summary": "Mark Online Order Dispatched & Trigger Webhook",
        "tags": ["E-Commerce Integration"],
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "BMS Order ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["courier_name", "tracking_number"],
                "properties": {
                  "courier_name": { "type": "string", "example": "Speed Post" },
                  "tracking_number": { "type": "string", "example": "EK987654321IN" },
                  "tracking_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Order marked dispatched and webhook delivered to website" }
        }
      }
    },
    "/api/v1/procurement": {
      "get": {
        "summary": "List Purchase Orders",
        "tags": ["Procurement & Purchase Orders"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of POs" } }
      },
      "post": {
        "summary": "Create Purchase Order",
        "tags": ["Procurement & Purchase Orders"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "201": { "description": "PO created" } }
      }
    },
    "/api/v1/restock": {
      "get": {
        "summary": "List Restock Requests",
        "tags": ["Restock Requests"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of restock requests" } }
      },
      "post": {
        "summary": "Create Restock Request",
        "tags": ["Restock Requests"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "201": { "description": "Restock request created" } }
      }
    },
    "/api/v1/transfers": {
      "get": {
        "summary": "List Stock Transfers",
        "tags": ["Stock Transfers"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of inter-branch transfers" } }
      },
      "post": {
        "summary": "Initiate Stock Transfer",
        "tags": ["Stock Transfers"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "201": { "description": "Transfer initiated" } }
      }
    },
    "/api/v1/exhibitions": {
      "get": {
        "summary": "List Exhibitions",
        "tags": ["Exhibitions"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of exhibitions" } }
      },
      "post": {
        "summary": "Create Exhibition Event",
        "tags": ["Exhibitions"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "201": { "description": "Exhibition created" } }
      }
    },
    "/api/v1/billing": {
      "get": {
        "summary": "List Bills & Invoices",
        "tags": ["Billing & Sales"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of bills" } }
      },
      "post": {
        "summary": "Create POS Bill",
        "tags": ["Billing & Sales"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "201": { "description": "Bill created" } }
      }
    }
  }
}
